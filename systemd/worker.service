[Unit]
Description=FFInventory Async Lookup Worker
After=network.target

[Service]
Type=simple
User=felix
WorkingDirectory=/home/felix/repos/Inventory
ExecStart=/home/felix/repos/Inventory/.venv/bin/python -m src.worker.main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
