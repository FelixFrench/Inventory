[Unit]
Description=FFInventory Async Lookup Worker
After=network.target fastapi.service

[Service]
Type=simple
User=<user>
WorkingDirectory=<repo-path>
ExecStart=<repo-path>/.venv/bin/python -m src.worker.main
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=<repo-path>

[Install]
WantedBy=multi-user.target
